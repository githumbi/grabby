  "repository": {
    "type": "git",
    "url": "https://github.com/githumbi/grabby.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/githumbi/grabby",
  "bugs": "https://github.com/githumbi/grabby/issues",
  "keywords": [
    "grabby",
    "feedback",
    "mcp",
    "model-context-protocol",
    "ai",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  }
