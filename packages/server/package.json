{
  "name": "@githumbi/grabby-server",
  "version": "0.1.0",
  "description": "Self-hosted collector and MCP server for Grabby feedback comments",
  "author": "Githumbi <githumbi74@gmail.com>",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "grabby-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "node -e \"const fs=require('fs');fs.copyFileSync('../../LICENSE','LICENSE')\" && node scripts/build-inbox.mjs",
    "pretest": "node scripts/build-inbox.mjs",
    "typecheck": "node scripts/build-inbox.mjs && tsc --noEmit -p . && tsc --noEmit -p src/inbox"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@githumbi/grabby": "workspace:^",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githumbi/grabby.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/githumbi/grabby",
  "bugs": "https://github.com/githumbi/grabby/issues",
  "keywords": [
    "grabby",
    "feedback",
    "mcp",
    "model-context-protocol",
    "ai",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  }
}
